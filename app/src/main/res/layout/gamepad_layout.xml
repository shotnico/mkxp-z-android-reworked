<?xml version="1.0" encoding="utf-8"?>
<!--
    Controlli a schermo, ORIZZONTALE - Pokemon Fire Ash ITA.
    Il verticale sta in res/layout-port/gamepad_layout.xml (Android sceglie da se').

    Disposizione a rombo, stile Switch:

                  [SU]
            [GIU]      [A]          A   = conferma / interagisci   (RGSS C, tasto C)
                  [B]               B   = indietro / menu          (RGSS B, tasto X)
                                    SU  = scorri le liste in su    (RGSS X, tasto A)
                                    GIU = scorri le liste in giu'  (RGSS Y, tasto S)

    Le etichette A e B usano i nomi che ci si aspetta da un gioco Pokemon, NON i
    nomi RGSS: attenzione, il pulsante che RGSS chiama "A" e' la corsa, qui
    etichettato CORSA e messo a portata del pollice destro perche' va tenuto
    premuto mentre si cammina. Corrispondenza completa in GamepadConfig.java.

    Rispetto al layout originale del port: rimossa la fila CTRL / ALT / SHIFT,
    che il gioco non usa e che stava ancorata in basso al centro, cioe' sopra la
    finestra dei dialoghi.

    Con "fixedAspectRatio": true il gioco 4:3 resta centrato e i controlli
    finiscono sulle bande nere laterali, senza coprire la scena.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gamepad_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
>
    <!-- ============== D-Pad: movimento ============== -->
    <com.hatkid.mkxpz.gamepad.GamepadDPad
        android:id="@+id/dpad"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_130sdp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:clickable="false"
        android:focusable="false"
        app:bgDrawable="@drawable/gamepad_dpad_back"
        app:fgDrawable="@drawable/gamepad_dpad_front"
    />

    <!-- ============== L: salva / ordina zaino ============== -->
    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_L"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_16sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck"
    />

    <!-- ============== R: velocizza ============== -->
    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_R"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_16sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck"
    />

    <!-- ============== Rombo: SU / GIU / A / B ============== -->
    <RelativeLayout
        android:id="@+id/buttons_action_layout"
        android:layout_width="@dimen/_155sdp"
        android:layout_height="@dimen/_155sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_8sdp"
    >
        <!-- vertice ALTO: SU -->
        <com.hatkid.mkxpz.gamepad.GamepadButton
            android:id="@+id/button_X"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:bgDrawable="@drawable/gamepad_button_circle"
            tools:ignore="ImageContrastCheck"
        />
        <!-- vertice SINISTRO: GIU -->
        <com.hatkid.mkxpz.gamepad.GamepadButton
            android:id="@+id/button_Y"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:bgDrawable="@drawable/gamepad_button_circle"
            tools:ignore="ImageContrastCheck"
        />
        <!-- vertice DESTRO: A = conferma -->
        <com.hatkid.mkxpz.gamepad.GamepadButton
            android:id="@+id/button_C"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:bgDrawable="@drawable/gamepad_button_circle"
            tools:ignore="ImageContrastCheck"
        />
        <!-- vertice BASSO: B = indietro / menu -->
        <com.hatkid.mkxpz.gamepad.GamepadButton
            android:id="@+id/button_B"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:bgDrawable="@drawable/gamepad_button_circle"
            tools:ignore="ImageContrastCheck"
        />
    </RelativeLayout>

    <!-- ============== CORSA: da tenere premuto camminando ============== -->
    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_A"
        android:layout_width="@dimen/_46sdp"
        android:layout_height="@dimen/_46sdp"
        android:layout_toStartOf="@+id/buttons_action_layout"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_20sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck"
    />

    <!-- ============== OGG: oggetto registrato ============== -->
    <com.hatkid.mkxpz.gamepad.GamepadButton
        android:id="@+id/button_Z"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_toStartOf="@+id/buttons_action_layout"
        android:layout_above="@+id/button_A"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_marginStart="@dimen/_4sdp"
        app:bgDrawable="@drawable/gamepad_button_circle"
        tools:ignore="ImageContrastCheck"
    />
</RelativeLayout>
