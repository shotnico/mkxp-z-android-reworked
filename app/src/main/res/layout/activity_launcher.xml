<?xml version="1.0" encoding="utf-8"?>
<!--
    Schermata iniziale: si apre prima del gioco. Gioca, lingua, tasti,
    orientamento. Verticale, scorrevole, cosi' sta bene su qualsiasi telefono.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101018"
    android:fillViewport="true"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
    >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#F5F5F5"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="4dp"
        />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9AA0B4"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="20dp"
        />

        <Button
            android:id="@+id/button_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play"
            android:textSize="18sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
        />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading_notice"
            android:textColor="#7E859B"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="22dp"
        />

        <!-- ===================== Lingua ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"
        />

        <RadioGroup
            android:id="@+id/group_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
        >
            <RadioButton
                android:id="@+id/lang_it"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/lang_it"
                android:textColor="#DDE1EC"
            />
            <RadioButton
                android:id="@+id/lang_en"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/lang_en"
                android:textColor="#DDE1EC"
            />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language_notice"
            android:textColor="#7E859B"
            android:textSize="11sp"
            android:paddingBottom="20dp"
        />

        <!-- ===================== Tasti a schermo ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"
        />

        <TextView
            android:id="@+id/label_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDE1EC"
            android:textSize="13sp"
        />

        <SeekBar
            android:id="@+id/seek_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="20"
            tools:ignore="UnusedAttribute"
        />

        <TextView
            android:id="@+id/label_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDE1EC"
            android:textSize="13sp"
            android:paddingTop="10dp"
        />

        <SeekBar
            android:id="@+id/seek_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="160"
            android:min="60"
            tools:ignore="UnusedAttribute"
            android:paddingBottom="20dp"
        />

        <!-- ===================== Orientamento ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/orientation"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"
        />

        <RadioGroup
            android:id="@+id/group_orient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        >
            <RadioButton
                android:id="@+id/orient_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orient_auto"
                android:textColor="#DDE1EC"
            />
            <RadioButton
                android:id="@+id/orient_land"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orient_land"
                android:textColor="#DDE1EC"
            />
            <RadioButton
                android:id="@+id/orient_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orient_port"
                android:textColor="#DDE1EC"
            />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/orient_notice"
            android:textColor="#7E859B"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
        />
    </LinearLayout>
</ScrollView>
