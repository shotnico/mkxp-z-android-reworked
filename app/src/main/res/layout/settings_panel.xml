<?xml version="1.0" encoding="utf-8"?>
<!--
    Impostazioni, aperte DURANTE il gioco dal tasto con l'ingranaggio in alto a
    sinistra.

    Prima erano una schermata di attesa all'avvio: serviva perche' il gioco
    impiegava oltre un minuto a partire e quel tempo andava occupato con
    qualcosa di utile. Ora il gioco e' pronto in pochi secondi (pathCache
    spento, vedi mkxp.json), quindi una schermata di attesa non ha piu' senso e
    le impostazioni stanno dove servono: mentre giochi.

    NON copre tutto lo schermo, di proposito: MainActivity.applyPanelLayout() la
    limita in modo che i tasti restino SCOPERTI e si vedano cambiare mentre si
    regola l'opacita'. Sono l'anteprima. Mentre il pannello e' aperto i tasti non
    inviano nulla al gioco (Gamepad.setInputEnabled(false)) ma si illuminano
    quando li premi, cosi' puoi provarne posizione e dimensione.

    Non c'e' la scelta dell'orientamento: l'app segue sempre il telefono. Girarlo
    basta. La voce c'era e forzava l'orientamento con setRequestedOrientation, e
    quella richiesta impediva alla superficie di disegno di stabilizzarsi: con
    "Verticale" il gioco non partiva affatto.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F00D0D14"
    android:clickable="true"
    android:focusable="true"
    android:fillViewport="true"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
    >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#F5F5F5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
        />

        <Button
            android:id="@+id/settings_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_game"
            android:textSize="17sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="10dp"
        />

        <!-- ==== Opzioni del gioco: si apre la schermata del GIOCO ====
             Si chiamava "Audio", ma da qui si arriva a TUTTE le opzioni del
             gioco (velocita' del testo, efficacia delle mosse, meteo...),
             non solo al volume: il titolo sbagliato le nascondeva.
             Sta in cima perche' e' la voce che si usa piu' spesso; i tasti
             a schermo si regolano una volta e poi non si toccano piu'.
             Musica ed effetti hanno gia' un'impostazione dentro Pokemon
             Essentials, salvata nella partita. Un cursore qui avrebbe creato una
             seconda manopola scollegata dalla prima, e due manopole per la
             stessa cosa sono peggio di nessuna. Questo tasto porta a quella
             vera, senza dover passare dal menu di pausa. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_options_title"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="18dp"
        />

        <Button
            android:id="@+id/open_game_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_options_open"
            android:textSize="13sp"
        />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_options_hint"
            android:textColor="#9AA3B2"
            android:textSize="11sp"
            android:paddingBottom="4dp"
        />

        <!-- ===================== Tasti a schermo ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
        />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_preview"
            android:textColor="#8CE0A8"
            android:textSize="11sp"
            android:paddingBottom="4dp"
        />

        <TextView
            android:id="@+id/label_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDE1EC"
            android:textSize="12sp"
        />

        <SeekBar
            android:id="@+id/seek_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="20"
            tools:ignore="UnusedAttribute"
        />

        <TextView
            android:id="@+id/label_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDE1EC"
            android:textSize="12sp"
        />

        <SeekBar
            android:id="@+id/seek_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="160"
            android:min="60"
            tools:ignore="UnusedAttribute"
        />

        <!-- ===================== Lingua ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language"
            android:textColor="#F5F5F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
        />

        <RadioGroup
            android:id="@+id/group_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
        >
            <RadioButton
                android:id="@+id/lang_it"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/lang_it"
                android:textColor="#DDE1EC"
                android:textSize="12sp"
            />
            <RadioButton
                android:id="@+id/lang_en"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/lang_en"
                android:textColor="#DDE1EC"
                android:textSize="12sp"
            />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language_notice_restart"
            android:textColor="#7E859B"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:paddingBottom="12dp"
        />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/orientation_note"
            android:textColor="#7E859B"
            android:textSize="11sp"
            android:paddingBottom="8dp"
        />
    </LinearLayout>
</ScrollView>
